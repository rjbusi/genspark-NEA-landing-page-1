---
import Icon from './Icon.astro';
import { t, site } from '../lib/site.js';
interface Props { lang: 'en' | 'es'; kind: 'callback' | 'plan'; id: string; dark?: boolean }
const { lang, kind, id, dark = false } = Astro.props;
const s = t(lang);
const f = s.form;
---
<form class:list={['form', dark && 'dark-form']} id={id} method="post" action="/api/lead" novalidate data-lead-form data-kind={kind}
  data-msg-required={f.required} data-msg-phone={f.badPhone} data-msg-consent={f.needConsent}
  data-ok-h={f.okH} data-ok-p={f.okP} data-sending={f.sending}>
  <input type="hidden" name="kind" value={kind} />
  <input type="hidden" name="lang" value={lang} />
  <input type="hidden" name="code" value="" />
  <div class="field">
    <label for={`${id}-first`}>{f.first}</label>
    <input id={`${id}-first`} name="firstName" autocomplete="given-name" required maxlength="60" />
    <span class="err" aria-live="polite"></span>
  </div>
  <div class="field">
    <label for={`${id}-last`}>{f.last}</label>
    <input id={`${id}-last`} name="lastName" autocomplete="family-name" required maxlength="60" />
    <span class="err" aria-live="polite"></span>
  </div>
  <div class="field">
    <label for={`${id}-phone`}>{f.phone}</label>
    <input id={`${id}-phone`} name="phone" type="tel" inputmode="tel" autocomplete="tel-national" required maxlength="20" />
    <span class="err" aria-live="polite"></span>
  </div>
  <div class="field">
    <label for={`${id}-best`}>{f.best}</label>
    <select id={`${id}-best`} name="bestTime">
      {Object.entries(f.times).map(([k, v]) => <option value={k} selected={k === 'any'}>{v}</option>)}
    </select>
    <span class="err" aria-live="polite"></span>
  </div>
  <div class="hp" aria-hidden="true">
    <label for={`${id}-company`}>{f.honeypot}</label>
    <input id={`${id}-company`} name="company" tabindex="-1" autocomplete="off" />
  </div>
  <label class="check">
    <input type="checkbox" name="consent" value="yes" required />
    <span>{f.consent}</span>
  </label>
  <div class="submit-row">
    <button class="btn" type="submit" data-cta={`submit-${kind}`}>{f.submit}<Icon name="arrow" size={18} /></button>
    <span class="privacy">{f.privacy}</span>
  </div>
  <div class="form-state ok" role="status" aria-live="polite" tabindex="-1"></div>
  <div class="form-state bad" role="alert">
    <strong>{f.errH}</strong>
    <p>{f.errP} <a href={`tel:${site.phone.tel}`}>{site.phone.display}</a></p>
  </div>
</form>
