---
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';
import { t } from '../lib/site.js';
const s = t('en');
const faq = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: s.faq.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base lang="en" schema={[faq]}><Home lang="en" /></Base>
